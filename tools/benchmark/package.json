{
  "name": "@a2d/benchmark",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test .test-dist/*.test.js",
    "bench": "vite --host 0.0.0.0",
    "compare": "node src/compare.mjs"
  },
  "dependencies": {
    "@a2d/avatar-schema": "workspace:*",
    "@a2d/runtime-api": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "5.8.3",
    "vite": "^8.0.0"
  }
}
