{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a2d.local/spec/avatar-ir.schema.json",
  "title": "A2D Avatar IR v1",
  "type": "object",
  "required": [
    "formatVersion",
    "id",
    "canvas",
    "parameters",
    "parts",
    "deformers",
    "buffers"
  ],
  "properties": {
    "formatVersion": {"const": 1},
    "id": {"type": "string","minLength": 1},
    "name": {"type": "string"},
    "canvas": {"type":"object","required":["width","height"],"properties":{"width":{"type":"integer","minimum":1},"height":{"type":"integer","minimum":1}},"additionalProperties":false},
    "buffers": {"type":"array","items":{"type":"object","required":["id","uri","byteLength"],"properties":{"id":{"type":"string"},"uri":{"type":"string"},"byteLength":{"type":"integer","minimum":0}},"additionalProperties":false}},
    "parameters": {"type":"array","items":{"$ref":"#/$defs/parameter"}},
    "parts": {"type":"array","items":{"$ref":"#/$defs/part"}},
    "deformers": {"type":"array","items":{"$ref":"#/$defs/deformer"}},
    "physics": {"type":"array","items":{"$ref":"#/$defs/physicsGroup"},"default":[]},
    "deformationBuffers": {"type":"object","properties":{"morphInfluences":{"type":"object","required":["view","strideBytes"],"properties":{"view":{"$ref":"#/$defs/structuredBufferView"},"strideBytes":{"const":16}},"additionalProperties":false}},"additionalProperties":false}
  },
  "$defs": {
    "bufferView": {"type":"object","required":["buffer","byteOffset","byteLength","componentType","count"],"properties":{"buffer":{"type":"string"},"byteOffset":{"type":"integer","minimum":0},"byteLength":{"type":"integer","minimum":0},"componentType":{"enum":["f32","u16","u32"]},"count":{"type":"integer","minimum":0},"stride":{"type":"integer","minimum":0}},"additionalProperties":false},
    "parameter": {"type":"object","required":["id","min","max","default"],"properties":{"id":{"type":"string"},"min":{"type":"number"},"max":{"type":"number"},"default":{"type":"number"}},"additionalProperties":false},
    "part": {"type":"object","required":["id","semantic","drawOrder","mesh"],"properties":{"id":{"type":"string"},"name":{"type":"string"},"semantic":{"enum":["face","eye_l","eye_r","iris_l","iris_r","mouth","hair_front","hair_side","hair_back","body","arm_l","arm_r","cloth","accessory","other"]},"parent":{"type":["string","null"]},"drawOrder":{"type":"integer"},"textureAtlas":{"type":["string","null"]},"mesh":{"type":"object","required":["positions","uvs","indices"],"properties":{"positions":{"$ref":"#/$defs/bufferView"},"uvs":{"$ref":"#/$defs/bufferView"},"indices":{"$ref":"#/$defs/bufferView"},"proxyZ":{"$ref":"#/$defs/bufferView"},"influenceRanges":{"$ref":"#/$defs/bufferView"}},"additionalProperties":false}},"additionalProperties":false},
    "deformer": {"type":"object","required":["id","type","targets"],"properties":{"id":{"type":"string"},"type":{"enum":["warp","rotation","morph","pseudo3d_head"]},"parent":{"type":["string","null"]},"targets":{"type":"array","items":{"type":"string"}},"parameterBindings":{"type":"array","items":{"type":"object","required":["parameterId"],"properties":{"parameterId":{"type":"string"},"scale":{"type":"number","default":1},"bias":{"type":"number","default":0}},"additionalProperties":false},"default":[]},"data":{"type":"object"}},"additionalProperties":false},
    "physicsGroup": {"type":"object","required":["id","type","nodeCount","segmentLength","root","gravity","damping","stiffness"],"properties":{"id":{"type":"string","minLength":1},"type":{"const":"spring_chain"},"nodeCount":{"type":"integer","minimum":2,"maximum":64},"segmentLength":{"type":"number","exclusiveMinimum":0},"root":{"type":"array","prefixItems":[{"type":"number"},{"type":"number"}],"minItems":2,"maxItems":2},"gravity":{"type":"array","prefixItems":[{"type":"number"},{"type":"number"}],"minItems":2,"maxItems":2},"damping":{"type":"number","minimum":0,"maximum":1},"stiffness":{"type":"number","minimum":0,"maximum":1},"inputBindings":{"type":"array","items":{"$ref":"#/$defs/physicsInputBinding"},"default":[]},"outputBindings":{"type":"array","items":{"$ref":"#/$defs/physicsOutputBinding"},"default":[]},"maxDisplacement":{"type":"number","exclusiveMinimum":0}},"additionalProperties":false},
    "pseudo3DHeadData": {"type":"object","required":["pivot","radius","depthScale","perspective","yawGain","pitchGain"],"properties":{"pivot":{"type":"array","prefixItems":[{"type":"number"},{"type":"number"}],"minItems":2,"maxItems":2},"radius":{"type":"array","prefixItems":[{"type":"number"},{"type":"number"}],"minItems":2,"maxItems":2},"depthScale":{"type":"number"},"perspective":{"type":"number"},"yawGain":{"type":"number"},"pitchGain":{"type":"number"}},"additionalProperties":false},
    "structuredBufferView": {"type":"object","required":["buffer","byteOffset","byteLength","count","stride"],"properties":{"buffer":{"type":"string"},"byteOffset":{"type":"integer","minimum":0},"byteLength":{"type":"integer","minimum":0},"count":{"type":"integer","minimum":0},"stride":{"type":"integer","minimum":1}},"additionalProperties":false},
    "physicsInputBinding": {"type":"object","required":["parameterId","axis","gain"],"properties":{"parameterId":{"type":"string","minLength":1},"axis":{"enum":["x","y"]},"gain":{"type":"number"}},"additionalProperties":false},
    "physicsOutputBinding": {"type":"object","required":["parameterId","axis","source","gain","min","max"],"properties":{"parameterId":{"type":"string","minLength":1},"axis":{"enum":["x","y"]},"source":{"enum":["tip","average"]},"gain":{"type":"number"},"min":{"type":"number"},"max":{"type":"number"}},"additionalProperties":false}
  },
  "additionalProperties": false
}